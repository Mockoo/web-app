# Copy to .env.local and fill in.

# REQUIRED in production – long random string used to sign session cookies.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# Public site URL (used for metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "false" if you run `next start` over plain http (e.g. on a LAN) so the
# session cookie is not marked Secure.
COOKIE_SECURE=true
